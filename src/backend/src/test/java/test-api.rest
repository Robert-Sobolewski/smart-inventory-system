### 3. SETUP: Create Product (Protected)
# Goal: Add a product to the catalog.
# Header: Replace <TOKEN> with the token from Step 1.
POST http://localhost:8888/api/products/create
Authorization: Bearer <TOKEN>
Content-Type: application/json

{
    "sku": "TEST-001",
    "name": "Industrial Capacitor 10uF",
    "category": "Electronics",
    "description": "High precision capacitor for industrial use"
}

### 4. LOGISTICS: Receive Goods (Protected)
# Goal: Add stock to the warehouse.
# Header: Replace <TOKEN> with the token from Step 1.
POST http://localhost:8888/api/logistics/receive
Authorization: Bearer <TOKEN>
Content-Type: application/json

{
    "sku": "TEST-001",
    "loc": "A-01",
    "qty": 100
}

### 5. LOGISTICS: Check Total Stock (Protected)
# Goal: Verify that the stock was correctly added.
# Header: Replace <TOKEN> with the token from Step 1.
GET http://localhost:8888/api/logistics/stock/TEST-001
Authorization: Bearer <TOKEN>

### 6. LOGISTICS: Issue Goods - FIFO Test (Protected)
# Goal: Remove some stock and test if it works.
# Header: Replace <TOKEN> with the token from Step 1.
POST http://localhost:8888/api/logistics/issue
Authorization: Bearer <TOKEN>
Content-Type: application/json

{
    "sku": "TEST-001",
    "qty": 30
}

### 7. VERIFY: Final Stock Check (Protected)
# Goal: Should now show 70 pieces remaining.
# Header: Replace <TOKEN> with the token from Step 1.
GET http://localhost:8888/api/logistics/stock/TEST-001
Authorization: Bearer <TOKEN>

### 8. SECURITY TEST: Unauthorized Access (Negative Test)
# Goal: Try to access stock WITHOUT a token.
# Expected Result: 401 Unauthorized or 403 Forbidden.
GET http://localhost:8888/api/logistics/stock/TEST-001
