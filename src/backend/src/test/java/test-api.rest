# SIS-IE API TEST SUITE
# Instructions: 
# 1. Start the Spring Boot application.
# 2. Run requests in order.
# 3. Copy the 'token' from the Login response and use it in the Authorization header for all other requests.

### 1. AUTHENTICATION (The Gateway)
# Goal: Get a JWT Token to access protected resources.
# Expected Result: 200 OK with { "token": "eyJ..." }
# user role_admin - admin, Admin123!
POST http://localhost:8888/api/auth/login
Content-Type: application/json

{
    "username": "admin",
    "password": "Admin123!"
}

### get token for a user role_manager: manager, Manager123!
POST http://localhost:8888/api/auth/login
Content-Type: application/json

{
    "username": "manager",
    "password": "Manager123!"
}

### get token for a user role_worker: worker, Worker123!
POST http://localhost:8888/api/auth/login
Content-Type: application/json

{
    "username": "worker",
    "password": "Worker123!"
}

### 2. SETUP: Create Location (Protected)
# Goal: Ensure we have a place to store items.
# Header: Replace <TOKEN> with the token from Step 1.
POST http://localhost:8888/api/locations/create?code=A-01
Authorization: Bearer <TOKEN>
Content-Type: application/json

